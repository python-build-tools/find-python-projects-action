{
  "name": "find-python-projects-action",
  "version": "1.0.0",
  "description": "GitHub Action for discovering Python projects in a repository and exposing helpful things from pyproject.toml to other steps.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "prepare": "ncc build index.js -o dist --source-map --license licenses.txt",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "all": "npm run lint && npm run prepare && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrandonLWhite/find-python-projects-action.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BrandonLWhite/find-python-projects-action/issues"
  },
  "homepage": "https://github.com/BrandonLWhite/find-python-projects-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@iarna/toml": "^2.2.5",
    "globby": "^11.1.0",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.2",
    "@vercel/ncc": "^0.44.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "jest": {
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./*.js",
      "!./eslint.config.js"
    ]
  }
}
